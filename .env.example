# Copy to .env and adjust. .env is gitignored and never committed.

DATABASE_URL="file:./dev.db"

# Needed only to run the crawlers, which refuse to start without it.
#
# Every request to a store carries this, so the store can reach whoever is
# running the crawler. Put YOUR OWN email address or web page here.
# CRAWLER_CONTACT=you@example.com

# Needed only for `npm run nightly`: the name of the ONE machine that runs the
# night and writes the database (as the operating system reports it). The
# command refuses to run anywhere else.
# NIGHTLY_HOST=my-server

# The admin pages (/admin/*) exist only where this is exactly "true". There
# are none at the moment; this keeps any future one off the public site.
#
# LEAVE IT OUT ON THE PUBLIC SERVER. Those pages have no password: they are not
# protected, they are simply not served. /admin/* answers 404 unless this is
# set, so a server that was never configured is safe by default.
#
# Set it on the machine where you maintain the site.
# ADMIN_ENABLED=true
