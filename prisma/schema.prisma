// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Product {
  id          String  @id @default(cuid())
  name        String
  category    String? // top-level menu entry, e.g. "Carne"
  subcategory String? // e.g. "Frango" - optional, product still shows under category if empty
  unit        String? // canonical comparison base, e.g. "L" or "kg" - prices are normalized to this for fair comparison across stores
  ean         String? // set only when identical across all listings (national-brand case)

  listings StoreListing[]
}

model StoreListing {
  id             String  @id @default(cuid())
  product        Product @relation(fields: [productId], references: [id])
  productId      String
  store          Store
  storeProductId String // sku/id at that store
  url            String // product page URL used to scrape
  ean            String? // barcode as scraped from this store; null if unavailable
  packageSize    Float   @default(1) // this store's package size, expressed in Product.unit (e.g. 0.75 for 750ml when unit is "L")

  snapshots PriceSnapshot[]

  @@unique([store, storeProductId])
}

model PriceSnapshot {
  id             String       @id @default(cuid())
  storeListing   StoreListing @relation(fields: [storeListingId], references: [id])
  storeListingId String
  date           DateTime // truncated to day
  price          Float

  // Promotion state as published on the day. Note the three stores expose very
  // different amounts of this, so two of the fields are frequently null:
  //   Continente - publishes the pre-promo price, but no end date
  //   Pingo Doce - publishes an end date (day/month only), but no pre-promo price
  //   Auchan     - publishes an end date, but no pre-promo price
  //
  // `false` on any row written before this field existed means "unknown, never
  // captured" - NOT "verified not on promotion". A page only ever shows today's
  // state, so historical promo status cannot be backfilled.
  onPromotion  Boolean   @default(false)
  regularPrice Float? // price before the discount; Continente only
  promoEndsAt  DateTime? // Auchan gives a full date; Pingo Doce gives day/month and the year is inferred

  capturedAt DateTime @default(now())

  @@unique([storeListingId, date])
}

enum Store {
  CONTINENTE
  PINGO_DOCE
  AUCHAN
}

/// Raw per-store catalogue built by the discovery crawl: every food product a
/// store lists, before any cross-store matching. Deliberately separate from
/// Product / StoreListing, which are the *curated, tracked* comparisons the site
/// shows - this table is the wide, messy input the matcher reads from, not
/// output anyone sees. A crawler (not built yet) upserts into it.
model CatalogueProduct {
  id             String  @id @default(cuid())
  store          Store
  storeProductId String // the store's own SKU / id
  name           String
  brand          String? // as listed; own-brand / empty is handled by the matcher, not here
  categoryPath   String? // the store's OWN path, e.g. "mercearia/conservas/..."; not the app taxonomy
  url            String // product page URL

  // last-crawled listing price - feeds the matcher's unit-price guard, and is
  // NOT authoritative price history (that stays in PriceSnapshot for tracked products)
  price Float?

  // Size and barcode come from candidate ENRICHMENT (a product-page fetch), not
  // the listing crawl - tiles carry neither reliably. Null until enriched.
  packageSize   Float? // total base quantity in `unit`, e.g. 0.4 for 400 g when unit is "kg"
  unit          String? // "kg" or "l"
  ean           String? // raw barcode as scraped; may be a GS1 prefix-2 scale ticket
  eanNormalized String? // GTIN-14, and null whenever `ean` is restricted-circulation or invalid - the ONLY field safe to match on

  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  enrichedAt  DateTime? // when the product page was last fetched for size/EAN; null = never enriched

  /// When we last ATTEMPTED this product, successfully or not - which is a
  /// different fact from `lastSeenAt` ("last confirmed to exist"), and the two
  /// cannot share a column. A 404 leaves `lastSeenAt` frozen, and a frozen old
  /// timestamp sorts to the FRONT of a stalest-first queue: order the nightly
  /// crawl by it and every dead product marches to the head of the line and is
  /// re-fetched first, climbing higher the longer it stays dead.
  lastCheckedAt DateTime?

  /// Consecutive nights the product page returned nothing. Reset to 0 by any
  /// successful fetch, so a single bad night cannot accumulate.
  deadCount Int @default(0)

  /// What KIND of food this is - "batata", "queijo" - shared across stores, so
  /// "where are potatoes cheapest" has an answer. Distinct from `categoryPath`,
  /// which is the store's own shelf and too coarse: all three chains file
  /// potatoes alongside sweet potatoes, onions and garlic. Derived from the
  /// product NAME by src/lib/food-types.ts and rewritten by `npm run
  /// classify:food`, so it is safe to recompute after the curated table changes.
  /// Null for anything unrecognised, which is most of the catalogue and is
  /// deliberately left honest rather than forced into a bucket.
  foodType String?

  /// Last time a product-page confirmed this product is LISTED BUT UNAVAILABLE:
  /// the page loads and the product exists, but carries no price - out of stock,
  /// or sold by variable weight with no fixed price. Distinct from `delistedAt`
  /// (the store stopped selling it) and from an unreachable page (we could not
  /// tell). Its grid tile has no price either, so the walk always skips it and it
  /// is permanently "missing"; without this marker phase 2 would re-fetch its
  /// page every single night. Set here, it is rechecked on a slow cadence
  /// instead, and cleared the moment the product is seen in a grid again.
  unavailableAt DateTime?

  /// Set once `deadCount` reaches 3: we believe the store stopped selling this.
  /// A MARKER, never a deletion - the row and its whole CataloguePrice history
  /// stay, because "this cost EUR 1.15 until it vanished" is real history. It
  /// drops the product out of the nightly queue (re-checked at 90 days instead)
  /// and is what a user-facing catalogue would filter on later.
  delistedAt DateTime?

  /// Set when this row was reconciled to a SUCCESSOR id by barcode: the same
  /// product returned under a new storeProductId, and its price history was
  /// moved onto that row. A tombstone - kept and delisted, but its
  /// CataloguePrice rows now live on `supersededById`. Plain id, not a relation:
  /// nothing is ever deleted, so there is no integrity to enforce, and the
  /// matcher joins on it when it needs to.
  supersededById String?

  @@unique([store, storeProductId])
  @@index([store, brand]) // brand blocking
  @@index([store, categoryPath]) // category blocking
  @@index([eanNormalized]) // EAN match / veto
  @@index([store, delistedAt, lastCheckedAt]) // the nightly queue, stalest first
  @@index([store, supersededById]) // finding tombstones / their successors
  @@index([foodType, store]) // cheapest-per-store within a food type
  candidatesA MatchCandidate[] @relation("CandidateA")
  candidatesB MatchCandidate[] @relation("CandidateB")
  prices      CataloguePrice[]
}

/// A guess that two catalogue products, at different stores, are the same
/// product. Guesses only: generated from name and brand alone, before any
/// product page has been fetched, so nothing here is a decision.
///
/// Stored as unordered PAIRS rather than groups. A group is what we eventually
/// want, but it is not what can be judged: group sizes vary (of the 95
/// hand-made ones, 82 span three stores, 12 span two, and one holds five
/// listings), similarity is not transitive, and a reviewer can answer "are
/// these two the same?" far more reliably than a three-way question. Groups are
/// formed later by clustering the CONFIRMED pairs, which is also what lets a
/// fourth or fifth store be added without changing the model.
///
/// Derived data: the generator wipes and rebuilds the table, so re-running with
/// a different threshold is a re-run rather than a migration.
model MatchCandidate {
  id String @id @default(cuid())

  // canonical order (store, then id) so one pair is never stored twice
  a      CatalogueProduct @relation("CandidateA", fields: [aId], references: [id], onDelete: Cascade)
  aId    String
  b      CatalogueProduct @relation("CandidateB", fields: [bId], references: [id], onDelete: Cascade)
  bId    String
  storeA Store // denormalised so the review queue can filter by store pair
  storeB Store

  nameSimilarity Float // token overlap, the score that got this pair in
  block          String // "brand" or "token": which pass found it. Token-only is the weaker claim
  priceRatio     Float? // larger listing price over smaller. NOT euro/kg - that needs a package size we do not have yet

  generatedAt DateTime @default(now())

  @@unique([aId, bId])
  @@index([nameSimilarity]) // the review queue sorts on this
  @@index([storeA, storeB])
}

/// One crawl of one store, with what each section returned. Kept so a run can
/// be compared against the one before it: a category that quietly halves, or
/// stops being crawled at all, is invisible to any single run's own checks -
/// those only ask whether the store's published count was met, not whether the
/// store is still publishing what it did yesterday.
model CrawlRun {
  id        String         @id @default(cuid())
  store     Store
  startedAt DateTime       @default(now())
  /// distinct products kept across the whole run
  total     Int
  /// Request stats for the run, so "the site is behaving normally" can be
  /// judged against previous runs rather than asserted. A crawl that suddenly
  /// takes three times longer, or starts retrying, is being throttled - and
  /// that is the warning that arrives before a block, not after.
  requests  Int?
  /// HTML processed, i.e. page size AFTER decompression - what the parser saw,
  /// not what crossed the network. The two differ by ~6.4x on Continente.
  bytes     Int?
  /// Compressed bytes actually transferred, when the responses reported a size.
  /// Null when nothing did (a chunked response carries no content-length).
  wireBytes Int?
  fetchMs   Int?
  retries   Int?
  /// Product ids the sitemap published this run. The next run compares against
  /// it: a sitemap that suddenly shrinks is far more likely to be a bad deploy
  /// or a truncated response than a store that lost thousands of products
  /// overnight, and acting on it would raise a false alarm.
  sitemapEntries Int?
  /// Product sitemap FILES the index listed. Catches what the entry count
  /// cannot: the files need not be equally sized, so losing a small one can
  /// move the address count by less than the 5% that looks suspicious.
  sitemapFiles   Int?

  /// Whether the two figures above were BELIEVED, as opposed to merely
  /// observed. They are recorded either way.
  ///
  /// Recording only trusted runs looks safer and is not: if the store
  /// legitimately reorganises from six sitemap files to five, every future run
  /// compares against the last trusted six, distrusts the sitemap, and skips
  /// discovery - forever. The catalogue stops growing and the only symptom is a
  /// warning that never resolves. Keeping the disbelieved observations is what
  /// lets a persistent change be told apart from a one-night glitch, and
  /// eventually accepted as the new normal.
  sitemapTrusted Boolean?

  /// Entries per sitemap file, as JSON `[{url, entries}]`.
  ///
  /// The aggregate count hides partial damage: a file truncated at 90% loses
  /// ~1.5% of the addresses, well under the 5% that looks suspicious, so
  /// nothing fires. Comparing each file against its own previous size catches
  /// what comparing the total cannot.
  sitemapPerFile String?

  /// `<loc>` entries whose product id could not be extracted, so they were
  /// dropped. Should be 0. It was 170 for months, silently, when the id pattern
  /// matched digits only - this is the alarm for the next time the URL shape
  /// changes.
  sitemapUnparseable Int?

  /// The size of the ProductCheck table for this run's store, split by verdict.
  ///
  /// ProductCheck should only ever grow, and mostly by the discovery budget, so
  /// a fall is the anomaly worth catching: it means rows vanished from a table
  /// nothing deletes from. Recorded so the next run can compare, exactly as the
  /// sitemap figures are.
  checkNotFood Int?
  checkDead    Int?

  /// How big CatalogueProduct was for EVERY store when this run finished, as
  /// JSON `[{store, total, delisted}]`.
  ///
  /// Recorded rather than derived. Nothing deletes catalogue rows today, so the
  /// size could in principle be reconstructed by counting `firstSeenAt` before
  /// a date - but that silently stops being true the first time anything is
  /// deleted by hand, and a growth figure that quietly becomes wrong is worse
  /// than one that costs a column. All three stores, not just this run's, so a
  /// store that stops being crawled shows up as a flat line rather than
  /// vanishing from the report.
  catalogueSizes String?

  /// Grid-walk bookkeeping, for stores crawled by listing grid rather than by
  /// sitemap (Auchan today, Pingo Doce later). Named store-neutrally; a store
  /// crawled another way simply leaves them null, exactly as Auchan leaves the
  /// sitemap columns above null. The grid crawl's answer to the sitemap figures:
  /// they are what the next run compares against to catch a whole food
  /// department appearing under an unrecognised name, or the tile parser quietly
  /// dropping products.

  /// Every top segment the walk saw, as JSON `[{segment, count, kept}]` - the
  /// grid crawl's equivalent of the sitemap's per-file entries.
  segmentTally  String?
  /// What the store's own result counter published across the walk, against
  /// which `walkedTotal` is checked for a truncated crawl.
  publishedTotal Int?
  /// Distinct products the walk actually fetched, food and non-food together.
  walkedTotal    Int?
  /// `[data-gtm]` tiles the walk encountered - the denominator for tile yield,
  /// which catches a renamed attribute that would otherwise shrink the catalogue
  /// in silence.
  tilesSeen      Int?
  /// Of those, how many parsed to a usable product.
  tilesKept      Int?
  /// Well-formed tiles carrying no price - out-of-stock products the store still
  /// lists but cannot sell today. Skipped, not a fault; recorded apart from
  /// malformed so the two are never confused when reading a run back.
  tilesUnpriced  Int?
  /// Tiles broken in a way a healthy grid never is (bad JSON, or a missing
  /// id/name/url). The tile-yield alarm's numerator, kept from a ~0% baseline by
  /// excluding the unpriced tiles above.
  tilesMalformed Int?
  /// Tiles that parsed but carried no category path, so would drop as non-food.
  /// A spike means the whole catalogue is about to read as non-food.
  emptyCategory  Int?

  sections       CrawlSection[]

  @@index([store, startedAt])
}

/// A product id we opened and decided NOT to keep, so we never open it again.
///
/// Continente publishes ~101,000 product ids; ~17,000 are food we track. The
/// rest are non-food or delisted, and finding that out costs one request each -
/// about 24 hours in total. Without this table that cost is paid on EVERY
/// discovery run, because the answer is thrown away. With it, discovery is a
/// set subtraction against the sitemap and a handful of fetches for whatever is
/// genuinely new.
///
/// Food is deliberately NOT here. Every published id lives in exactly one of
/// CatalogueProduct (food we track) or this table (everything rejected), so the
/// two can never disagree about the same product - and "in neither" is exactly
/// the definition of an id still needing examination.
model ProductCheck {
  id             String  @id @default(cuid())
  store          Store
  storeProductId String
  url            String
  verdict        Verdict
  categoryPath   String? // what it was, when the page had one
  name           String? // enough to recognise it in a report

  /// Verdicts go stale: a delisted product can return, a non-food item can be
  /// recategorised. Anything older than 90 days goes back in the queue at a
  /// trickle, which is what stops this table becoming a way of being
  /// permanently wrong.
  checkedAt  DateTime
  checkCount Int      @default(1)

  @@unique([store, storeProductId])
  @@index([store, checkedAt]) // entries due for a re-check
}

enum Verdict {
  /// The page loaded and the product is real, but not in a food section.
  NOT_FOOD
  /// The page returned nothing: the store no longer sells this.
  DEAD
}

/// A verdict on one candidate pair: are these two catalogue products, at
/// different stores, the same thing?
///
/// Separate from MatchCandidate because that table is DERIVED - the generator
/// wipes and rebuilds it on every run, so a verdict stored there would be
/// destroyed by a re-run with a different threshold. Keyed instead on the two
/// catalogue ids, which are stable cuids that survive regeneration.
///
/// A match is not permanent. A product gets delisted, or re-issued under a new
/// id, and yesterday's correct pair becomes today's wrong one - so a decision
/// can be RETIRED rather than silently left standing over a product nobody
/// sells. Retired, never deleted: the record of what was once matched is what
/// stops the same bad pair being re-proposed and re-reviewed from scratch.
model MatchDecision {
  id  String @id @default(cuid())
  /// canonically ordered (aId <= bId) so one pair is never stored twice
  aId String
  bId String

  verdict MatchVerdict
  /// HUMAN verdicts are never overwritten by a later AUTO pass: re-running the
  /// matcher must not silently undo a person's judgement.
  source  DecisionSource

  /// The evidence behind the verdict, from classifyCandidate, kept so a
  /// decision can be explained later without recomputing it.
  rung           String
  vetoed         Boolean @default(false)
  nameSimilarity Float
  sizeRatio      Float?
  priceGap       Float?
  reason         String

  decidedAt DateTime @default(now())

  /// Set when the pair stopped being valid - a member was delisted, or was
  /// superseded by a different id. The pair drops out of grouping from then on,
  /// and the surviving member returns to the candidate pool for re-matching.
  retiredAt     DateTime?
  retiredReason String?

  @@unique([aId, bId])
  @@index([verdict, retiredAt]) // the grouping read: live confirmed pairs
  @@index([aId])
  @@index([bId])
}

enum MatchVerdict {
  /// The same product. Feeds grouping.
  CONFIRMED
  /// Not the same product.
  REJECTED
  /// Cannot be settled from the evidence available; waiting on a human.
  REVIEW
}

enum DecisionSource {
  AUTO
  HUMAN
}

/// A set of catalogue products, at different stores, believed to be the same
/// product - the thing the app compares prices across.
///
/// DERIVED, like MatchCandidate: recomputed from scratch on every matcher run by
/// clustering the currently-valid confirmed pairs. That is deliberate. It means a
/// group shrinks from a triplet to a pair when one store drops the product, and
/// grows back when a new match is confirmed, with no incremental repair path to
/// get wrong.
///
/// Deliberately NOT the same thing as `Product`/`StoreListing`, which are the
/// hand-curated comparisons the live site shows. Auto-derived groups must not
/// appear on the site silently; promoting one is a separate, deliberate step.
///
/// Size-agnostic in shape: two members or six, one store or five. Nothing here
/// assumes a pair or a triplet, which is what lets a fourth store be added
/// without a model change.
model ProductGroup {
  id        String   @id @default(cuid())
  /// how many distinct stores are represented - what "is this a triplet?" asks
  storeCount Int
  /// how many products, which exceeds storeCount when a chain stocks two SKUs
  memberCount Int
  /// true when every link holding this group together was a barcode or
  /// brand+size+name match, rather than a weaker one
  strong    Boolean  @default(false)
  /// guard flags raised while clustering, as JSON; empty on a clean group
  flags     String?
  builtAt   DateTime @default(now())

  members ProductGroupMember[]

  @@index([storeCount])
}

model ProductGroupMember {
  id      String       @id @default(cuid())
  group   ProductGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId String
  /// the CatalogueProduct.id; a plain id rather than a relation because groups
  /// are wiped and rebuilt, and nothing should cascade back into the catalogue
  productId String
  store     Store

  @@unique([groupId, productId])
  @@index([productId])
}

model CrawlSection {
  id        String   @id @default(cuid())
  run       CrawlRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId     String
  cgid      String
  label     String
  /// distinct products this section contributed, after run-wide dedup
  collected Int
  /// what the store said the section held, when it said
  expected  Int?

  @@index([runId])
}

/// The price of a catalogue product over time, as one row per PRICE rather than
/// one per day.
///
/// Every crawl already reads every product's price off its listing tile, so this
/// costs no extra requests - it only stops us overwriting yesterday's reading.
/// A row per product per day would be ~15 million rows a year and still could
/// not distinguish "the price held steady" from "we missed a crawl"; a period
/// answers both, and costs a row only when the price actually moves.
///
/// Gaps are deliberately left visible. A product that disappears for a week and
/// comes back at the same price keeps ONE period, and the silence between the
/// old lastSeenAt and the new one is there for anyone reading the series. There
/// is no need to record "we did not see this" when the absence says it.
///
/// Fed only by the crawl (via persistCatalogue). Enrichment deliberately does
/// not write prices: it covers an arbitrary subset on no schedule, and mixing
/// two sources would inject apparent price changes wherever a product page and
/// its listing tile disagree.
model CataloguePrice {
  id          String           @id @default(cuid())
  product     CatalogueProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId   String
  price       Float
  firstSeenAt DateTime
  lastSeenAt  DateTime
  /// Exactly one period per product is open. A denormalisation - the open one is
  /// also the one with the greatest firstSeenAt - kept because this lookup runs
  /// 42,000 times per crawl and wants a single indexed query.
  isOpen      Boolean          @default(true)

  @@index([productId, isOpen])
  @@index([productId, firstSeenAt])
}
